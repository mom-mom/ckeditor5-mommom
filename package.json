  "description": "Mommom editor from CKEditor5",
  "version": "0.1.20",
  "license": "SEE LICENSE IN LICENSE.md",
  "main": "./build/ckeditor.umd.js",
  "module": "./build/ckeditor.mjs",
  "types": "./build/ckeditor.d.ts",
  "exports": {
    ".": {
