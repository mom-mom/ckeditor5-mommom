  "devDependencies": {
    "css-loader": "^5.2.7",
    "esbuild-loader": "^4.4.2",
    "postcss": "^8.4.36",
    "postcss-loader": "^4.3.0",
    "prettier": "^3.2.5",
    "raw-loader": "^4.0.2",
    "style-loader": "^2.0.0",
    "terser-webpack-plugin": "^4.2.3",
    "ts-loader": "^9.5.1",
    "typescript": "5.0.4",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^4.10.0"
